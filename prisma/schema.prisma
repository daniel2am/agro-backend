generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusFazenda {
  ativa
  inativa
}

enum StatusInvernada {
  disponivel
  ocupada
  inativa
}

enum StatusLavoura {
  ativo
  inativo
}

enum StatusAnimal {
  ativo
  vendido
  morto
}

enum TipoUsuario {
  usuario
  administrador
  gestor
}

enum TipoDispositivo {
  bastao
  balanca
  antena
  outro
}

enum TipoLeituraDispositivo {
  brinco
  peso
  antena
  outro
}

enum PapelUsuarioFazenda {
  administrador
  gestor
  colaborador
}

enum PlanoTipo {
  basico
  intermediario
  avancado
}

enum TipoFinanceiro {
  receita
  despesa
}

enum UnidadeIdade {
  dias
  meses
  anos
}

model Fazenda {
  id            String        @id @default(uuid())
  nome          String
  cidade        String
  estado        String
  cadastroIncra String        @unique
  car           String?
  areaTotal     Float?
  status        StatusFazenda @default(ativa)
  criadoEm      DateTime      @default(now())

  usuarios     FazendaUsuario[]
  convites     ConviteFazenda[]
  invernadas   Invernada[]
  lavouras     Lavoura[]
  animais      Animal[]
  rebanhos     Rebanho[]
  titulares    TitularFazenda[]
  dispositivos Dispositivo[]
  leituras     LeituraDispositivo[]
  Financeiro   Financeiro[]
  manejos      Manejo[]
  pesagens     Pesagem[]
  ocorrencias  Ocorrencia[]
  compras      CompraInsumo[]
  chuvas       Chuva[]
  imovelRural  ImovelRural?
  ndvi         NdviMedicao[]

  @@index([id, criadoEm])
}

model TitularFazenda {
  id                 String  @id @default(uuid())
  fazendaId          String
  nome               String
  cpfCnpj            String
  nacionalidade      String
  condicao           String
  percentualDetencao Float
  fazenda            Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
}

model FazendaUsuario {
  id        String              @id @default(uuid())
  usuarioId String
  fazendaId String
  papel     PapelUsuarioFazenda
  ativo     Boolean             @default(true)
  criadoEm  DateTime            @default(now())
  usuario   Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  fazenda   Fazenda             @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fazendaId])
}

model Animal {
  id           String               @id @default(uuid())
  brinco       String
  fazendaId    String
  invernadaId  String?
  rebanhoId    String?
  nome         String?
  sexo         String?
  peso         Float?
  lote         String?
  raca         String?
  idade        Int?
  unidadeIdade UnidadeIdade?
  status       StatusAnimal         @default(ativo)
  dataSaida    DateTime?
  leituras     LeituraDispositivo[]
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
  fazenda      Fazenda              @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  invernada    Invernada?           @relation(fields: [invernadaId], references: [id], name: "AnimaisNaInvernada", onDelete: SetNull)
  rebanho      Rebanho?             @relation(fields: [rebanhoId], references: [id], onDelete: SetNull)
  Sanidade     Sanidade[]
  medicamentos Medicamento[]
  manejos      Manejo[]
  pesagens     Pesagem[]
  ocorrencias  Ocorrencia[]
  financeiros  Financeiro[]

  @@unique([fazendaId, brinco])
  @@index([fazendaId])
  @@index([invernadaId])
  @@index([rebanhoId])
  @@index([status])
}

model Rebanho {
  id           String   @id @default(uuid())
  fazendaId    String
  nome         String
  tipo         String? // cria, recria, engorda, vaca, touro, etc
  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  fazenda Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  animais Animal[]

  @@index([fazendaId])
}

model Invernada {
  id        String               @id @default(uuid())
  nome      String
  area      Float
  descricao String?
  poligono  Json?
  status    StatusInvernada      @default(disponivel)
  fazendaId String
  criadoEm  DateTime             @default(now())
  fazenda   Fazenda              @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  animais   Animal[]             @relation("AnimaisNaInvernada")
  leituras  LeituraDispositivo[]

  @@index([fazendaId, nome])
}

model Lavoura {
  id            String                @id @default(uuid())
  nome          String
  cultura       String
  areaHa        Float
  dataPlantio   DateTime
  semente       String?
  poligono      Json? // perímetro [{latitude, longitude}] para o monitoramento por satélite
  status        StatusLavoura         @default(ativo)
  fazendaId     String
  criadoEm      DateTime              @default(now())
  fazenda       Fazenda               @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  vendas        Financeiro[]          @relation("VendaDaLavoura")
  custos        Financeiro[]          @relation("CustoDaLavoura")
  procedimentos ProcedimentoLavoura[]

  @@index([fazendaId, dataPlantio])
}

model ProcedimentoLavoura {
  id          String   @id @default(uuid())
  lavouraId   String
  tipo        String // defensivo, irrigação, adubação, colheita, etc
  data        DateTime
  produto     String?
  quantidade  String?
  responsavel String?
  observacoes String?
  criadoEm    DateTime @default(now())

  lavoura Lavoura @relation(fields: [lavouraId], references: [id], onDelete: Cascade)

  @@index([lavouraId, data])
}

model MarcaModeloDispositivo {
  id           String          @id @default(uuid())
  fabricante   String
  modelo       String
  tipo         TipoDispositivo
  protocolo    String?
  infoExtra    String?
  dispositivos Dispositivo[]
}

model Dispositivo {
  id            String   @id @default(uuid())
  nome          String
  usuarioId     String?
  fazendaId     String?
  marcaModeloId String
  numeroSerie   String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  marcaModelo MarcaModeloDispositivo @relation(fields: [marcaModeloId], references: [id], onDelete: Cascade)
  usuario     Usuario?               @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fazenda     Fazenda?               @relation(fields: [fazendaId], references: [id], onDelete: SetNull)
  leituras    LeituraDispositivo[]

  @@index([usuarioId])
  @@index([fazendaId])
}

model LeituraDispositivo {
  id            String                 @id @default(uuid())
  animalId      String?
  dispositivoId String
  fazendaId     String
  invernadaId   String?
  usuarioId     String
  tipo          TipoLeituraDispositivo
  valor         String
  dataLeitura   DateTime               @default(now())
  metadados     Json?

  animal      Animal?     @relation(fields: [animalId], references: [id], onDelete: SetNull)
  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  fazenda     Fazenda     @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  invernada   Invernada?  @relation(fields: [invernadaId], references: [id], onDelete: SetNull)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([fazendaId, dataLeitura])
  @@index([animalId, dataLeitura])
}

model Usuario {
  id                String      @id @default(uuid())
  nome              String
  email             String      @unique
  senha             String
  fotoUrl           String?
  status            String      @default("ativo")
  tipo              TipoUsuario @default(usuario)
  criadoEm          DateTime    @default(now())
  atualizadoEm      DateTime    @updatedAt
  ultimoLogin       DateTime?
  googleId          String?     @unique
  appleId           String?     @unique
  resetToken        String?     @db.VarChar(255)
  resetTokenExpires DateTime?
  termosAceitosEm   DateTime?

  // Plano comercial. `planoAteEm` nulo = sem vencimento; vencido equivale a básico.
  plano      PlanoTipo @default(basico)
  planoAteEm DateTime?

  convitesEnviados ConviteFazenda[]
  fazendas         FazendaUsuario[]
  acessos          LogAcesso[]
  dispositivos     Dispositivo[]
  leituras         LeituraDispositivo[]
  compras          CompraInsumo[]
  contribuinte     ContribuinteRural?
  contasBancarias  ContaBancaria[]

  @@index([status])
}

// Convite para entrar numa fazenda, feito por e-mail. Se a pessoa ainda não tem
// conta, fica pendente e é aceito automaticamente quando ela se cadastrar.
model ConviteFazenda {
  id             String              @id @default(uuid())
  fazendaId      String
  email          String
  papel          PapelUsuarioFazenda
  convidadoPorId String
  criadoEm       DateTime            @default(now())

  fazenda      Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  convidadoPor Usuario @relation(fields: [convidadoPorId], references: [id], onDelete: Cascade)

  @@unique([fazendaId, email])
  @@index([email])
}

model LogAcesso {
  id        String   @id @default(uuid())
  usuarioId String
  data      DateTime @default(now())
  acao      String
  ip        String?
  userAgent String?
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, data])
}

model Sanidade {
  id          String   @id @default(uuid())
  animalId    String
  data        DateTime
  tipo        String
  observacoes String?
  criadoEm    DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, data])
}

model Financeiro {
  id        String         @id @default(uuid())
  fazendaId String
  data      DateTime
  descricao String
  valor     Float
  tipo      TipoFinanceiro
  criadoEm  DateTime       @default(now())

  // NOVO: vínculo 1–1 com CompraInsumo
  compraInsumoId String?       @unique
  compraInsumo   CompraInsumo? @relation(fields: [compraInsumoId], references: [id], onDelete: Cascade)

  // Venda de gado: dá baixa automática no animal vendido
  animalId String?
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  // Venda de lavoura: subtrai areaVendidaHa da área total da lavoura
  lavouraId     String?
  lavoura       Lavoura? @relation("VendaDaLavoura", fields: [lavouraId], references: [id], onDelete: SetNull)
  areaVendidaHa Float?

  // Categoria do lançamento (ração, vacina, combustível…). Texto livre validado no DTO.
  categoria String?

  // Despesa alocada em uma lavoura (custo da safra). Diferente de `lavouraId`, que
  // significa VENDA e mexe na área da lavoura.
  custoLavouraId String?
  custoLavoura   Lavoura? @relation("CustoDaLavoura", fields: [custoLavouraId], references: [id], onDelete: SetNull)

  // Dados exigidos pelo LCDPR (livro caixa digital do produtor rural). Opcionais.
  contaBancariaId String?
  contaBancaria   ContaBancaria? @relation(fields: [contaBancariaId], references: [id], onDelete: SetNull)
  documentoTipo   Int? // 1 NF, 2 fatura, 3 recibo, 4 contrato, 5 folha, 6 outros
  documentoNumero String?
  contraparteDoc  String? // CPF/CNPJ de quem pagou/recebeu (só dígitos)
  contraparteNome String?

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@index([fazendaId, data])
  @@index([custoLavouraId])
  @@index([contaBancariaId])
  @@index([animalId])
  @@index([lavouraId])
  @@index([tipo])
}

model Medicamento {
  id               String       @id @default(uuid())
  animalId         String
  nome             String
  data             DateTime
  dosagem          String?
  viaAplicacao     String?
  observacoes      String?
  criadoEm         DateTime     @default(now())
  proximaAplicacao DateTime?
  lembreteAtivo    Boolean      @default(false)
  notificacaoId    String?      @unique
  notificacao      Notificacao? @relation(fields: [notificacaoId], references: [id])
  animal           Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, data])
  @@index([proximaAplicacao])
}

model Notificacao {
  id        String   @id @default(uuid())
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  medicamento Medicamento?
}

model Manejo {
  id         String   @id @default(uuid())
  fazendaId  String
  animalId   String
  tipo       String
  data       DateTime
  observacao String?
  criadoEm   DateTime @default(now())

  animal  Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@index([fazendaId, data])
  @@index([animalId, data])
}

model Pesagem {
  id        String   @id @default(uuid())
  animalId  String
  fazendaId String
  data      DateTime
  pesoKg    Float
  criadoEm  DateTime @default(now())

  animal  Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@index([animalId, data])
  @@index([fazendaId, data])
}

// Índice de vegetação (NDVI, satélite Sentinel-2) por intervalo de 10 dias de uma
// invernada ou lavoura. Guardado para não gastar a cota do provedor a cada abertura:
// uma linha por (alvo, início do intervalo), na grade fixa de 10 dias.
model NdviMedicao {
  id            String   @id @default(uuid())
  fazendaId     String
  alvoTipo      String // 'invernada' | 'lavoura'
  alvoId        String
  inicio        DateTime @db.Date
  fim           DateTime @db.Date
  media         Float? // null = sem pixel válido (nuvem) no intervalo
  minimo        Float?
  maximo        Float?
  desvio        Float?
  cobertura     Float // 0 a 1: fração de pixels úteis (sem nuvem, sombra ou água)
  atualizadoEm  DateTime @default(now()) @updatedAt

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@unique([alvoTipo, alvoId, inicio])
  @@index([fazendaId, alvoTipo, alvoId, inicio])
}

// ---------------------------------------------------------------- LCDPR
// Perfil fiscal do produtor (pessoa física que entrega o LCDPR). Um por usuário.
model ContribuinteRural {
  id            String   @id @default(uuid())
  usuarioId     String   @unique
  cpf           String
  nome          String
  endereco      String
  numero        String
  complemento   String?
  bairro        String
  uf            String
  codMunicipio  String // código IBGE de 7 dígitos
  cep           String
  telefone      String?
  email         String
  contadorNome  String?
  contadorDoc   String?
  contadorCrc   String?
  contadorEmail String?
  contadorFone  String?
  atualizadoEm  DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Dados fiscais de uma fazenda como imóvel rural (registro 0040 do LCDPR).
model ImovelRural {
  id                String   @id @default(uuid())
  fazendaId         String   @unique
  codItr            String? // CAFIR/NIRF, 8 dígitos
  caepf             String? // 14 dígitos
  inscricaoEstadual String?
  endereco          String
  numero            String?
  complemento       String?
  bairro            String
  cep               String
  codMunicipio      String
  tipoExploracao    Int      @default(1) // 1 individual, 2 condomínio, 3 arrendado, 4 parceria, 5 comodato, 6 outros
  participacaoPct   Float    @default(100)
  atualizadoEm      DateTime @updatedAt

  fazenda      Fazenda             @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  contrapartes ContraparteImovel[]
}

// Condôminos, arrendadores, parceiros… (registro 0045).
model ContraparteImovel {
  id         String @id @default(uuid())
  imovelId   String
  tipo       Int // 1 condômino, 2 arrendador, 3 parceiro, 4 comodante, 5 outro
  documento  String
  nome       String
  percentual Float

  imovel ImovelRural @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
}

model ContaBancaria {
  id          String   @id @default(uuid())
  usuarioId   String
  banco       String // código de compensação, 3 dígitos
  nomeBanco   String
  agencia     String // 4 dígitos, sem DV
  numeroConta String // com DV, só dígitos
  criadoEm    DateTime @default(now())

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lancamentos Financeiro[]

  @@index([usuarioId])
}

// Pluviômetro: um registro por fazenda por dia (reenviar o mesmo dia substitui o valor,
// o que também torna seguro repetir um envio feito offline).
model Chuva {
  id         String   @id @default(uuid())
  fazendaId  String
  data       DateTime @db.Date
  mm         Float
  observacao String?
  criadoEm   DateTime @default(now())

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)

  @@unique([fazendaId, data])
  @@index([fazendaId, data])
}

model Ocorrencia {
  id        String   @id @default(uuid())
  fazendaId String
  animalId  String?
  titulo    String
  descricao String?
  data      DateTime
  tipo      String
  criadoEm  DateTime @default(now())

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  animal  Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@index([fazendaId, data])
}

model Insumo {
  id       String   @id @default(uuid())
  nome     String
  unidade  String
  tipo     String
  criadoEm DateTime @default(now())
}

model CompraInsumo {
  id         String   @id @default(uuid())
  fazendaId  String
  usuarioId  String
  data       DateTime
  insumo     String
  quantidade Int
  unidade    String
  valor      Float
  fornecedor String?
  criadoEm   DateTime @default(now())

  fazenda Fazenda @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // NOVO: lado reverso do 1–1
  financeiro Financeiro?

  @@index([fazendaId, data])
  @@index([usuarioId, data])
}
